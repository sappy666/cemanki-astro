---
const { image, size, text } = Astro.props;
---
<article class="product-card reveal">
  <div class="product-image"><img src={image} alt={`Cemanki Oil ${size}`} loading="lazy" /></div>
  <p class="eyebrow">Aceite de oliva extra virgen</p>
  <h3>{size}</h3>
  <p>{text}</p>
  <a class="text-link" href="#contacto">Consultar <span>↗</span></a>
</article>